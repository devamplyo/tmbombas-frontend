# Copie para ".env" (usado pelo docker-compose.yml) e ajuste se necessário.

# Porta no host que serve o frontend (nginx escuta 80 dentro do container).
FRONTEND_PORT=8081

# URL do backend, vista de dentro da rede docker.
# Default: nome do container do backend (tmbombas-backend) na rede compartilhada.
API_BACKEND_URL=http://th_piscinas_api:4015
